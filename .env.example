# Copy this file to .env for local overrides. Docker Compose already supplies
# safe development defaults; no provider credential is needed for the current
# application foundation.
WOONLENS_ENVIRONMENT=development
WOONLENS_LOG_LEVEL=DEBUG
WOONLENS_PDOK_LOCATION_API_URL=https://api.pdok.nl/kadaster/location-api/v1
WOONLENS_PDOK_BAG_API_URL=https://api.pdok.nl/kadaster/bag/ogc/v2
WOONLENS_HTTP_CONNECT_TIMEOUT_SECONDS=2
WOONLENS_HTTP_READ_TIMEOUT_SECONDS=5
WOONLENS_HTTP_WRITE_TIMEOUT_SECONDS=2
WOONLENS_HTTP_POOL_TIMEOUT_SECONDS=2
WOONLENS_ADDRESS_SUGGESTION_LIMIT=8
