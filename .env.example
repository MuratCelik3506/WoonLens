# Copy this file to .env for local overrides. Docker Compose already supplies
# safe development defaults. Values ending in `local-...-only` are synthetic
# Docker fixtures and must never be reused in production.
WOONLENS_ENVIRONMENT=development
WOONLENS_LOG_LEVEL=DEBUG
WOONLENS_PDOK_LOCATION_API_URL=https://api.pdok.nl/kadaster/location-api/v1
WOONLENS_PDOK_BAG_API_URL=https://api.pdok.nl/kadaster/bag/ogc/v2
WOONLENS_PDOK_CBS_NEIGHBORHOODS_API_URL=https://api.pdok.nl/cbs/wijken-en-buurten-2026/ogc/v1
WOONLENS_PDOK_CBS_REGIONS_API_URL=https://api.pdok.nl/cbs/gebiedsindelingen/ogc/v1
WOONLENS_CBS_ADMINISTRATIVE_DATASET_YEAR=2026
WOONLENS_CBS_STATLINE_API_URL=https://datasets.cbs.nl/odata/v1/CBS
WOONLENS_CBS_NEIGHBORHOOD_INDICATORS_DATASET_ID=85984NED
WOONLENS_CBS_NEIGHBORHOOD_INDICATORS_DATASET_YEAR=2024
WOONLENS_HTTP_CONNECT_TIMEOUT_SECONDS=2
WOONLENS_HTTP_READ_TIMEOUT_SECONDS=5
WOONLENS_HTTP_WRITE_TIMEOUT_SECONDS=2
WOONLENS_HTTP_POOL_TIMEOUT_SECONDS=2
WOONLENS_ADDRESS_SUGGESTION_LIMIT=8
WOONLENS_BAG_MAX_RELATED_BUILDINGS=10
WOONLENS_EP_ONLINE_API_URL=https://public.ep-online.nl/api/v5
# Obtain your personal key from EP-Online. Never commit the populated value.
WOONLENS_EP_ONLINE_API_KEY=
WOONLENS_LUCHTMEETNET_API_URL=https://api.luchtmeetnet.nl/open_api
WOONLENS_RIVM_LUCHTMEETNET_METADATA_URL=https://data.rivm.nl/data/luchtmeetnet/Metadata
WOONLENS_ACCOUNT_FEATURES_ENABLED=true
WOONLENS_DATABASE_URL=postgresql+asyncpg://woonlens:woonlens-local-database-only@localhost:5432/woonlens
WOONLENS_OIDC_ISSUER=http://localhost:8080/realms/woonlens
WOONLENS_OIDC_JWKS_URL=http://localhost:8080/realms/woonlens/protocol/openid-connect/certs
WOONLENS_OIDC_AUDIENCE=woonlens-api
WOONLENS_OIDC_REQUIRED_SCOPE=woonlens:account

# Frontend configuration. NEXT_PUBLIC values are visible in browser bundles and
# must never contain provider credentials.
NEXT_PUBLIC_WOONLENS_API_BASE_URL=http://localhost:8000
WOONLENS_API_BASE_URL=http://localhost:8000
WOONLENS_OIDC_ISSUER=http://localhost:8080/realms/woonlens
WOONLENS_OIDC_INTERNAL_ORIGIN=http://localhost:8080
WOONLENS_OIDC_CLIENT_ID=woonlens-web
WOONLENS_OIDC_CLIENT_SECRET=woonlens-local-client-only
WOONLENS_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
WOONLENS_REDIS_URL=redis://localhost:6379/0
WOONLENS_SESSION_ENCRYPTION_KEY=bG9jYWwtZGV2ZWxvcG1lbnQtc2Vzc2lvbi1rZXkhISE=
